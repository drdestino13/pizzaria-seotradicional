---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Como Fazer Massa de Pizza em Casa | Pizza Barata do Zé">
  <h1>Como Fazer Massa de Pizza em Casa</h1>
  <img class="photo" src="https://images.unsplash.com/photo-1590947132387-155cc02f3212?w=1000&q=80" alt="Massa de pizza sendo preparada" loading="lazy" />
  <p>
    Misture farinha, água, fermento e sal. Sove por 10 minutos e deixe
    descansar.
  </p>
  <h2>Ingredientes</h2>
  <ul>
    <li>500g de farinha</li>
    <li>300ml de água</li>
    <li>10g de fermento</li>
    <li>10g de sal</li>
  </ul>
  <a href="/" class="badge">PEÇA AGORA A SUA PIZZA!!!</a>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import ConceptTag from "../components/ConceptTag.astro";
import CompareLink from "../components/CompareLink.astro";
---
<Layout title="Nossos Links | Pizza do Zé Delivery">
  <ConceptTag bloco="Tradicional" numero={2} nome="Backlinks Comprados em Massa" />
  <h1>Nossos Links</h1>
  <p>
    Pagamos R$ 200 por 500 links em sites de apostas, pneus e horóscopo. Ninguém que
    lê horóscopo tá com fome de pizza, mas o número de links subiu!
  </p>
  <CompareLink slug="backlinks-comprados" />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import ConceptTag from "../components/ConceptTag.astro";
import CompareLink from "../components/CompareLink.astro";
---
<Layout title="Pizza | Pizza do Zé Delivery">
  <ConceptTag bloco="Semântico" numero={1} nome="Co-ocorrência Semântica" />
  <h1>Pizza</h1>
  <div class="keyword-stuffed">
    Pizza é muito boa. Adoramos pizza. Nossa pizza é a melhor pizza. Peça pizza agora
    e receba sua pizza quentinha. Pizza pizza pizza, 40 vezes a palavra pizza e nunca
    uma palavra sobre massa, queijo ou forno.
  </div>
  <CompareLink slug="co-ocorrencia" />
</Layout>

---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Fale Conosco | Pizza Barata do Zé">
  <h1>Fale Conosco</h1>
  <img class="photo" src="https://images.unsplash.com/photo-1594007654729-407eedc4be65?w=1000&q=80" alt="Pizza da pizzaria" loading="lazy" />
  <p>
    Preencha o formulário abaixo ou envie um e-mail pra
    contato@pizzabaratadoze.com.br. Nossa equipe responde em até 48 horas.
  </p>
  <h2>Formulário de Contato</h2>
  <p>Nome, e-mail, assunto e mensagem. Campos obrigatórios.</p>
  <h2>Redes Sociais</h2>
  <p>Siga a gente no Instagram e Facebook pra novidades.</p>
</Layout>

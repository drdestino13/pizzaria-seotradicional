---
import Layout from "../../layouts/Layout.astro";

const posts = [
  { slug: "pizza-grande-quantas-pessoas", titulo: "Pizza Grande Serve Quantas Pessoas? Guia Pra Não Errar o Pedido", foto: "https://images.unsplash.com/photo-1571407970349-bc81e7e96d47?w=400&q=80" },
  { slug: "como-esquentar-pizza", titulo: "Pizza Esfriou? Veja Como Esquentar Sem Ressecar a Massa", foto: "https://images.unsplash.com/photo-1590947132387-155cc02f3212?w=400&q=80" },
  { slug: "vinho-para-pizza", titulo: "Qual Vinho Combina com Pizza? Guia de Harmonização", foto: "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=400&q=80" },
];
---
<Layout title="Blog | Pizza do Zé Delivery">
  <h1>Blog</h1>
  <p>Dicas de pizza aqui no blog da melhor pizzaria de SP!!!</p>
  <div class="photo-grid">
    {posts.map((p) => (
      <a href={`/blog/${p.slug}`}>
        <img src={p.foto} alt="foto" loading="lazy" />
      </a>
    ))}
  </div>
  <div class="related-links">
    <ul>
      {posts.map((p) => (
        <li><a href={`/blog/${p.slug}`}>{p.titulo}</a></li>
      ))}
    </ul>
  </div>
</Layout>

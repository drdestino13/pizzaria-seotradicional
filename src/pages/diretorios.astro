---
import Layout from "../layouts/Layout.astro";
import ConceptTag from "../components/ConceptTag.astro";
import CompareLink from "../components/CompareLink.astro";
---
<Layout title="Nossos Diretórios | Pizza do Zé Delivery">
  <ConceptTag bloco="Tradicional" numero={5} nome="Diretórios e Troca de Links" />
  <h1>Nossos Diretórios</h1>
  <p>Estamos cadastrados em mais de 80 diretórios genéricos (veja o rodapé desta página) e trocamos link com qualquer site que aceite:</p>
  <ul>
    <li><a href="#">Colchões Silva</a></li>
    <li><a href="#">Piscinas do Bairro</a></li>
    <li><a href="#">Horóscopo Diário</a></li>
  </ul>
  <p>Ninguém que compra colchão está com fome de pizza.</p>
  <CompareLink slug="diretorios" />
</Layout>

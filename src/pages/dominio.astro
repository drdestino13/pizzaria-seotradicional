---
import Layout from "../layouts/Layout.astro";
import ConceptTag from "../components/ConceptTag.astro";
import CompareLink from "../components/CompareLink.astro";
---
<Layout title="Nosso Domínio | Pizza do Zé Delivery">
  <ConceptTag bloco="Tradicional" numero={3} nome="Exact Match Domain" />
  <h1>Nosso Domínio</h1>
  <p>
    Nosso domínio dos sonhos seria <code>melhorpizzadesaopaulo.com.br</code>, mas por
    enquanto estamos em <code>pizzaria-seotradicional.vercel.app</code>. Não se preocupe
    com o nome do site, o nome já garante a primeira posição! (Não garante.)
  </p>
  <CompareLink slug="dominio" />
</Layout>

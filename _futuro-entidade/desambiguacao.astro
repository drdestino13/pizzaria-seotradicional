---
import Layout from "../layouts/Layout.astro";
import ConceptTag from "../components/ConceptTag.astro";
import CompareLink from "../components/CompareLink.astro";
---
<Layout title="Pizzaria do Zé | Pizza do Zé Delivery">
  <ConceptTag bloco="Entidade" numero={6} nome="Desambiguação de Entidade" />
  <h1>Pizzaria do Zé</h1>
  <p>
    Somos a Pizzaria do Zé. Simples assim, sem cidade, sem bairro, sem endereço fixo
    em todo lugar — quem procurar "Pizzaria do Zé" vai achar outras 4 em outras
    cidades e talvez ache a errada.
  </p>
  <CompareLink slug="desambiguacao" />
</Layout>
